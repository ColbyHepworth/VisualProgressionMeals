<?xml version="1.0" encoding="utf-8"?>
<!-- Puts back the normal art that Rustic Meal Retexture replaces. It fails when Rustic's art isn't on the item, so a wrong load order shows in the log. -->
<Patch>

  <!-- Simple meal -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="MealSimple"]/graphicData/texPath[text()="RusticMeal/Simple"]</xpath>
        <value>
          <texPath>Things/Item/Meal/Simple</texPath>
        </value>
      </li>
      <li MayRequire="VanillaExpanded.VTEXE" Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="MealSimple"]/graphicData/texPath</xpath>
        <value>
          <texPath>Things/Item/VTE_Meal/Simple</texPath>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="MealSimple"]/graphicData/drawRotated</xpath>
      </li>
    </operations>
  </Operation>

