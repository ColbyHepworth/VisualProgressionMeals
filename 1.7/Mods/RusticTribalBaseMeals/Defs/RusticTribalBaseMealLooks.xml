<!-- With Medieval Overhaul active too, each base meal made up to the neolithic age gets Rustic Meal Retexture's art. Medieval Overhaul's art follows in the medieval age. Packaged survival meals aren't listed: Medieval Overhaul's cloth wrap suits the tribal age too. -->
<Defs>

  <!-- Simple meal -->
  <VisualProgression.ItemLooksDef>
    <defName>VPRM_MealSimple_Tribal</defName>
    <item>MealSimple</item>
    <looks>
      <li><upToAge>Neolithic</upToAge><style>VPRM_MealSimple_Medieval</style></li>
    </looks>
  </VisualProgression.ItemLooksDef>

