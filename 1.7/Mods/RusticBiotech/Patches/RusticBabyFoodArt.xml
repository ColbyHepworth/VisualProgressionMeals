<?xml version="1.0" encoding="utf-8"?>
<!-- Puts back the normal art that Rustic Meal Retexture replaces. It fails when Rustic's art isn't on the item, so a wrong load order shows in the log. -->
<Patch>

  <!-- Baby food -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BabyFood"]/graphicData/texPath[text()="RusticMeal/BabyFood"]</xpath>
        <value>
          <texPath>Things/Item/Resource/BabyFood</texPath>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="BabyFood"]/graphicData/drawRotated</xpath>
      </li>
    </operations>
  </Operation>

</Patch>
