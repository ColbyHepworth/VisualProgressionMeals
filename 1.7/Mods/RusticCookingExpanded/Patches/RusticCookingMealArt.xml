<?xml version="1.0" encoding="utf-8"?>
<!-- Puts back the normal art that Rustic Meal Retexture replaces. It fails when Rustic's art isn't on the item, so a wrong load order shows in the log. -->
<Patch>

  <!-- Gourmet meal -->
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="VCE_MealGourmet"]/graphicData/texPath[text()="RusticMeal/Patches/VCE_Gourmet"]</xpath>
        <value>
          <texPath>Things/Meals/VCE_Gourmet</texPath>
        </value>
      </li>
      <li Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="VCE_MealGourmet"]/graphicData/drawRotated</xpath>
      </li>
    </operations>
  </Operation>

