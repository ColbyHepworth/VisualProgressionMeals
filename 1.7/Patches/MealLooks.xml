<?xml version="1.0" encoding="utf-8"?>
<!-- Gives each meal Medieval Overhaul's art when it's made up to the medieval age. -->
<Patch>

  <!-- Simple meal -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="MealSimple"]/comps</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="MealSimple"]/comps</xpath>
      <value>
        <li Class="VisualProgression.CompProperties_AgeLook">
          <looks>
            <li><upToAge>Medieval</upToAge><style>VPMO_MealSimple_Medieval</style></li>
          </looks>
        </li>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="MealSimple"]</xpath>
      <value>
        <comps>
          <li Class="VisualProgression.CompProperties_AgeLook">
            <looks>
              <li><upToAge>Medieval</upToAge><style>VPMO_MealSimple_Medieval</style></li>
            </looks>
          </li>
        </comps>
      </value>
    </nomatch>
  </Operation>

